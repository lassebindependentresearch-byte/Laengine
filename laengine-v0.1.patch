diff --git a/common/ngram-map.cpp b/common/ngram-map.cpp
index d1cb451..5afac6d 100644
--- a/common/ngram-map.cpp
+++ b/common/ngram-map.cpp
@@ -112,6 +112,43 @@ llama_tokens common_ngram_simple_draft(
 }
 
 
+llama_tokens common_ngram_prompt_draft(
+        const common_ngram_simple_config & config, const llama_tokens & source,
+        const llama_tokens & history, llama_token sampled) {
+    const size_t min_match = config.size_ngram;
+    if (source.size() <= min_match || history.size() + 1 < min_match) {
+        return {};
+    }
+
+    constexpr size_t max_lookback = 256;
+    const size_t lookback = std::min(std::max(min_match, max_lookback), history.size() + 1);
+    size_t best_match = min_match - 1;
+    size_t copy_start = 0;
+    for (size_t end = min_match - 1; end < source.size() - min_match; ++end) {
+        if (source[end] != sampled) {
+            continue;
+        }
+        size_t match = 1;
+        while (match <= end && match < lookback && source[end - match] == history[history.size() - match]) {
+            ++match;
+        }
+        if (match > best_match) {
+            best_match = match;
+            copy_start = end + 1;
+            if (match == lookback) {
+                break;
+            }
+        }
+    }
+    if (copy_start == 0) {
+        return {};
+    }
+
+    const size_t count = std::min<size_t>(config.size_mgram, source.size() - copy_start);
+    return llama_tokens(source.begin() + copy_start, source.begin() + copy_start + count);
+}
+
+
